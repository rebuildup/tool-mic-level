{
	"$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
	"formatter": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "none",
			"correctness": {
				"noUnusedImports": "error",
				"noUnusedVariables": "error"
			},
			"style": {
				"useNodejsImportProtocol": "error",
				"useTemplate": "error"
			}
		}
	},
	"files": {
		"includes": ["src/**/*", "__tests__/**/*", "*.{js,json,ts,tsx}"],
		"ignoreUnknown": true
	},
	"vcs": {
		"enabled": true,
		"clientKind": "git"
	}
}
